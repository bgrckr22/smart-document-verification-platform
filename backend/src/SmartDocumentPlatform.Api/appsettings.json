{
  "ComputerVision": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 60
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Uploads": {
    "MaxBytes": 10485760
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
