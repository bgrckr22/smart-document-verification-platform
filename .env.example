# Copy this file to .env. Keep .env local; it is ignored by Git.
# Replace the password before starting PostgreSQL or Docker Compose.
POSTGRES_DB=smart_document_db
POSTGRES_USER=smartdocs
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
# Used only when the project path contains non-ASCII characters.
LOCAL_PROJECT_DRIVE=S:

# Native Windows development
LOCAL_BACKEND_URL=http://localhost:5000
LOCAL_CV_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:5000
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000

# Optional Docker Compose host ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
